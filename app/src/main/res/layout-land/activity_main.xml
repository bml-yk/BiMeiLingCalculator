<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="2dp"
        android:theme="@style/ThemeOverlay.BiMeiLingCalculator.Toolbar"
        app:title="@string/app_name"
        app:titleTextColor="@color/text_red" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_title"
                    android:textColor="@color/text_red"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/student_line"
                    android:textColor="@color/text_red"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/input_instruction"
                    android:textColor="@color/text_red_soft"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/red_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/red_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/leftInputLayout"
                            style="@style/CalculatorInputField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/left_number_hint"
                            app:endIconTint="@color/text_red">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/leftInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLines="1"
                                android:textColor="@color/text_red"
                                android:textColorHint="@color/text_red_soft"
                                android:textSize="17sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/rightInputLayout"
                            style="@style/CalculatorInputField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="@string/right_number_hint"
                            app:endIconTint="@color/text_red">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/rightInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLines="1"
                                android:textColor="@color/text_red"
                                android:textColorHint="@color/text_red_soft"
                                android:textSize="17sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/operator_title"
                            android:textColor="@color/text_red"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/operatorGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checkedButton="@id/op_add"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/op_add"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/text_red"
                                android:contentDescription="@string/add"
                                android:gravity="center"
                                android:text="@string/symbol_add"
                                android:textColor="@color/text_red"
                                android:textSize="20sp" />

                            <RadioButton
                                android:id="@+id/op_subtract"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/text_red"
                                android:contentDescription="@string/subtract"
                                android:gravity="center"
                                android:text="@string/symbol_subtract"
                                android:textColor="@color/text_red"
                                android:textSize="20sp" />

                            <RadioButton
                                android:id="@+id/op_multiply"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/text_red"
                                android:contentDescription="@string/multiply"
                                android:gravity="center"
                                android:text="@string/symbol_multiply"
                                android:textColor="@color/text_red"
                                android:textSize="20sp" />

                            <RadioButton
                                android:id="@+id/op_divide"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/text_red"
                                android:contentDescription="@string/divide"
                                android:gravity="center"
                                android:text="@string/symbol_divide"
                                android:textColor="@color/text_red"
                                android:textSize="20sp" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/red_container"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/resultText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="104dp"
                        android:padding="16dp"
                        android:text="@string/result_placeholder"
                        android:textColor="@color/text_red"
                        android:textIsSelectable="true"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calculateButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/calculate"
                    android:textColor="@color/text_red"
                    app:backgroundTint="@color/red_surface"
                    app:strokeColor="@color/text_red"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:text="@string/clear"
                    android:textColor="@color/text_red"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/red_outline"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="@string/history_hint"
                    android:textColor="@color/text_red_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
